{
  "name": "lembrafarma",
  "private": true,
  "version": "1.0.0",
  "directories": {
    "test": "tests"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:auth\" \"vite --host 0.0.0.0\"",
    "dev:front": "vite --host 0.0.0.0",
    "server": "npm --prefix ../lembrafarma_api run medicamentos",
    "server:auth": "npm --prefix ../LembraFarmaAPI run dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/medicamentos-core.test.js && node tests/cpf.test.js",
    "test:auth": "node --test tests/auth-api.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "6.4.5"
  }
}
