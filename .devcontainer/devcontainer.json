{
  "name": "LembraFarma - desenvolvimento isolado",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "3000": {
      "label": "API local SQLite (nao publicar)",
      "onAutoForward": "ignore",
      "visibility": "private"
    },
    "5173": {
      "label": "LembraFarma - React",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm ci --prefix LembraFarma && npm ci --prefix LembraFarmaAPI",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
